# AI Provider Configuration
# Options: "openai" (default), "openrouter", "ollama", "anthropic", "custom"
AI_PROVIDER=ollama

# OpenAI API Key (REQUIRED if provider="openai")
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (REQUIRED if provider="openrouter")
# Get your API key from: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-

# Anthropic API Key (REQUIRED if provider="anthropic")
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI Model to use
# For OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# For OpenRouter: e.g., google/gemini-2.0-flash-001, anthropic/claude-3.5-sonnet
# For Ollama: e.g., llama3.1, deepseek-r1:32b
OPENAI_MODEL=qwen3-coder-next:cloud

# AI model to use specifically for multiple-choice option generation (optional)
# Defaults to OPENAI_MODEL when not set
OPENAI_OPTIONS_MODEL=

# Ollama Configuration (REQUIRED if provider="ollama")
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Custom Provider Configuration (REQUIRED if provider="custom")
# AI_BASE_URL=https://your-custom-endpoint.com/v1
# AI_API_KEY=your-api-key

# Google Analytics ID (optional)
# Get your GA4 measurement ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Spikelog API Key (optional)
# Get your API key from: https://spikelog.com
SPIKELOG_API_KEY=
